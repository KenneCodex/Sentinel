{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kennecodex.dev/schemas/msq_node_graph_v1.schema.json",
  "title": "MagicSquare Upgrade Node Graph v1",
  "type": "object",
  "required": ["graph_id", "version", "created_at", "cost_unit", "nodes"],
  "properties": {
    "graph_id": { "type": "string" },
    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "cost_unit": { "type": "string", "enum": ["SE", "CE", "TN"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "name", "cost", "requires", "effect"],
        "properties": {
          "node_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "cost": { "type": "integer", "minimum": 0 },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "effect": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

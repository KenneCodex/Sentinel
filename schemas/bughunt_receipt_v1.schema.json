{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KenneCodex/Sentinel/schemas/bughunt_receipt_v1.schema.json",
  "title": "Sentinel bug-hunt Archivist receipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "repository",
    "base_sha",
    "timestamp",
    "result",
    "surface_reviewed",
    "files_changed",
    "pr_created",
    "pr_allowed",
    "notification",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "bughunt_receipt_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_sha": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "result": {"enum": ["CLEAN", "NEW", "DUPLICATE", "BLOCKED"]},
    "surface_reviewed": {
      "type": "object",
      "required": ["files", "tests", "reproductions_attempted"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "tests": {"type": "integer", "minimum": 0},
        "reproductions_attempted": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "unique_reproducible_defects": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "defect": {
      "type": "object",
      "required": [
        "defect_id",
        "fingerprint",
        "repository",
        "component",
        "failure_class",
        "trigger",
        "affected_symbol",
        "normalized_root_cause"
      ],
      "properties": {
        "defect_id": {"type": "string", "pattern": "^BUG-[A-F0-9]{12}$"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "repository": {"type": "string"},
        "component": {"type": "string"},
        "failure_class": {"type": "string"},
        "trigger": {"type": "string"},
        "affected_symbol": {"type": "string"},
        "normalized_root_cause": {"type": "string"},
        "evidence": {}
      },
      "additionalProperties": false
    },
    "duplicate_of": {
      "type": "object",
      "required": ["source", "defect_id", "related_prs", "status"],
      "properties": {
        "source": {"enum": ["registry", "registry-fields", "open-pr-marker"]},
        "defect_id": {"type": "string"},
        "canonical_pr": {"type": ["integer", "null"], "minimum": 1},
        "related_prs": {
          "type": "array",
          "items": {"type": ["integer", "null"]},
          "uniqueItems": true
        },
        "status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pr_allowed": {"type": "boolean"},
    "pr_created": {"const": false},
    "pr_markers": {
      "type": "object",
      "required": ["defect_id", "fingerprint"],
      "properties": {
        "defect_id": {"type": "string"},
        "fingerprint": {"type": "string"}
      },
      "additionalProperties": false
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_action": {"type": "string", "minLength": 1},
    "notification": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "NEW"}}},
      "then": {
        "required": ["defect", "pr_markers"],
        "properties": {"pr_allowed": {"const": true}}
      }
    },
    {
      "if": {"properties": {"result": {"const": "DUPLICATE"}}},
      "then": {
        "required": ["defect", "duplicate_of"],
        "properties": {"pr_allowed": {"const": false}}
      }
    },
    {
      "if": {"properties": {"result": {"enum": ["CLEAN", "BLOCKED"]}}},
      "then": {"properties": {"pr_allowed": {"const": false}}}
    }
  ],
  "additionalProperties": false
}
